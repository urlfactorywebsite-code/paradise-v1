# Run npm run setup:docker to create .env with a random database password.
APP_PORT=6400
POSTGRES_DB=paradise
POSTGRES_USER=paradise
POSTGRES_PASSWORD=
COOKIE_SECURE=false
# APP_ORIGIN=https://quotes.example.com
# For running Node outside Docker, use a PostgreSQL connection URL:
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/paradise
# Optional XLSX pricing limits (defaults: 5 MiB, 5000 rows).
# MAX_PRICING_UPLOAD_BYTES=5242880
# MAX_PRICING_ROWS=5000
